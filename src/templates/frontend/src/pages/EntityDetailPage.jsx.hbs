import React, { useEffect, useState } from 'react';
import { useNavigate, useParams, Link } from 'react-router-dom';
import { ArrowLeft, Edit, Trash2, Calendar, Database } from 'lucide-react';
import { {{camelCase entity.name}}Api } from '../services/api';

export default function {{capitalize entity.name}}DetailPage() {
  const { id } = useParams();
  const navigate = useNavigate();
  const [item, setItem] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    async function loadItem() {
      try {
        setLoading(true);
        const res = await {{camelCase entity.name}}Api.getById(id);
        setItem(res.data);
      } catch (err) {
        setError(err.response?.data?.error || 'Failed to load {{lowercase entity.name}}');
      } finally {
        setLoading(false);
      }
    }
    loadItem();
  }, [id]);

  const handleDelete = async () => {
    if (!window.confirm('Are you sure you want to delete this {{lowercase entity.name}}?')) return;
    try {
      await {{camelCase entity.name}}Api.delete(id);
      navigate('/{{lowercase (pluralize entity.name)}}');
    } catch (err) {
      alert(err.response?.data?.error || 'Failed to delete');
    }
  };

  if (loading) {
    return (
      <div className="flex h-64 items-center justify-center">
        <div className="h-6 w-6 animate-spin rounded-full border-2 border-blue-600 border-t-transparent"></div>
      </div>
    );
  }

  if (error || !item) {
    return (
      <div className="text-center py-12">
        <p className="text-red-600 font-medium">{error || 'Item not found'}</p>
        <Link to="/{{lowercase (pluralize entity.name)}}" className="mt-4 inline-block text-sm text-blue-600 hover:underline">
          Back to list
        </Link>
      </div>
    );
  }

  return (
    <div className="max-w-4xl mx-auto py-2 space-y-6">
      <div className="flex items-center justify-between">
        <div className="flex items-center space-x-3">
          <Link
            to="/{{lowercase (pluralize entity.name)}}"
            className="p-2 rounded-lg text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors"
          >
            <ArrowLeft className="h-5 w-5" />
          </Link>
          <div>
            <h1 className="text-2xl font-bold tracking-tight text-gray-900">
              {{capitalize entity.name}} Details
            </h1>
            <p className="text-xs text-gray-400 font-mono">ID: {item._id}</p>
          </div>
        </div>

        <div className="flex items-center space-x-2">
          <Link
            to={`/{{lowercase (pluralize entity.name)}}/${item._id}/edit`}
            className="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
          >
            <Edit className="h-4 w-4" />
            <span>Edit</span>
          </Link>
          <button
            onClick={handleDelete}
            className="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-red-50 text-sm font-medium text-red-700 hover:bg-red-100 border border-red-200 transition-colors"
          >
            <Trash2 className="h-4 w-4" />
            <span>Delete</span>
          </button>
        </div>
      </div>

      <div className="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-xs divide-y divide-gray-100">
        {{#each entity.fields}}
        <div className="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
          <dt className="text-xs font-semibold uppercase tracking-wider text-gray-500">
            {{capitalize name}}
          </dt>
          <dd className="sm:col-span-2 text-sm text-gray-900">
            {{#if (eq type "boolean")}}
            <span className={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${item.{{name}} ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}`}>
              {item.{{name}} ? 'Enabled / True' : 'Disabled / False'}
            </span>
            {{else if (eq type "enum")}}
            <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
              {item.{{name}} || '-'}
            </span>
            {{else if (eq type "date")}}
            {item.{{name}} ? new Date(item.{{name}}).toLocaleDateString() : '-'}
            {{else if (eq type "text")}}
            <p className="whitespace-pre-wrap text-gray-700">{item.{{name}} || '-'}</p>
            {{else}}
            {String(item.{{name}} ?? '-')}
            {{/if}}
          </dd>
        </div>
        {{/each}}

        {{#each entity.relations}}
        {{#if (eq type "belongsTo")}}
        <div className="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
          <dt className="text-xs font-semibold uppercase tracking-wider text-gray-500">
            {{capitalize name}} ({{capitalize target}})
          </dt>
          <dd className="sm:col-span-2 text-sm text-gray-900">
            {item.{{name}} ? (
              <span className="inline-flex items-center px-2.5 py-1 rounded-md bg-gray-100 text-gray-800 font-medium text-xs">
                {item.{{name}}.name || item.{{name}}.title || item.{{name}}.email || item.{{name}}._id}
              </span>
            ) : (
              <span className="text-gray-400">None</span>
            )}
          </dd>
        </div>
        {{/if}}
        {{/each}}

        <div className="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 bg-gray-50/50">
          <dt className="text-xs font-semibold uppercase tracking-wider text-gray-400">Created At</dt>
          <dd className="sm:col-span-2 text-xs text-gray-500">
            {item.createdAt ? new Date(item.createdAt).toLocaleString() : '-'}
          </dd>
        </div>
        <div className="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 bg-gray-50/50">
          <dt className="text-xs font-semibold uppercase tracking-wider text-gray-400">Last Updated</dt>
          <dd className="sm:col-span-2 text-xs text-gray-500">
            {item.updatedAt ? new Date(item.updatedAt).toLocaleString() : '-'}
          </dd>
        </div>
      </div>
    </div>
  );
}
