import React from 'react';
import { Link, useNavigate } from 'react-router-dom';
{{#if app.auth}}
import { useAuth } from '../context/AuthContext';
import { LogOut, User as UserIcon } from 'lucide-react';
{{/if}}

export default function Navbar() {
  {{#if app.auth}}
  const { user, logout, isAuthenticated } = useAuth();
  const navigate = useNavigate();

  const handleLogout = () => {
    logout();
    navigate('/login');
  };
  {{/if}}

  return (
    <header className="sticky top-0 z-30 flex h-16 w-full items-center justify-between border-b border-gray-200 bg-white px-6 shadow-sm">
      <div className="flex items-center space-x-3">
        <Link to="/" className="flex items-center space-x-2 text-xl font-bold tracking-tight text-blue-600 hover:text-blue-700">
          <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white font-black text-base">
            {{capitalize (slice app.name 0 1)}}
          </div>
          <span>{{app.name}}</span>
        </Link>
      </div>

      <div className="flex items-center space-x-4">
        {{#if app.auth}}
        {isAuthenticated ? (
          <div className="flex items-center space-x-4">
            <div className="flex items-center space-x-2 text-sm text-gray-700 bg-gray-100 px-3 py-1.5 rounded-full">
              <UserIcon className="h-4 w-4 text-gray-500" />
              <span className="font-medium">{user?.name || user?.email}</span>
              {user?.role && (
                <span className="rounded bg-blue-100 px-1.5 py-0.5 text-xs font-semibold text-blue-800">
                  {user.role}
                </span>
              )}
            </div>
            <button
              onClick={handleLogout}
              className="flex items-center space-x-1 rounded-lg border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors"
              title="Sign Out"
            >
              <LogOut className="h-4 w-4 text-gray-500" />
              <span>Logout</span>
            </button>
          </div>
        ) : (
          <div className="flex items-center space-x-2">
            <Link
              to="/login"
              className="rounded-lg px-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors"
            >
              Sign In
            </Link>
            <Link
              to="/register"
              className="rounded-lg bg-blue-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors shadow-sm"
            >
              Register
            </Link>
          </div>
        )}
        {{/if}}
      </div>
    </header>
  );
}
